# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# RAHASIA — hanya dipakai di server. Jangan pernah diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Toko (MVP satu penjual): id baris di tabel sellers
STORE_SELLER_ID=11111111-1111-1111-1111-111111111111
# Nomor WA penjual format internasional tanpa + (contoh 6281234567890)
SELLER_WHATSAPP_NUMBER=6281200000000
# Opsional: URL gambar QRIS statis
NEXT_PUBLIC_QRIS_IMAGE_URL=

# URL publik toko (untuk link + QR di dashboard), contoh https://namatoko.vercel.app
NEXT_PUBLIC_SITE_URL=

# Telegram (OPSIONAL, mati secara default). Set true untuk mengaktifkan /api/telegram.
TELEGRAM_ENABLED=false
# Dari @BotFather
TELEGRAM_BOT_TOKEN=your-bot-token
# String acak panjang; dipakai di setWebhook secret_token
TELEGRAM_WEBHOOK_SECRET=change-me-random-string
