@startuml activity-order
title Activity Diagram - Alur Order (UMKM Auto-Order, migrasi 0002)
|Pembeli|
start
if (Channel order?) then (Web / wa.me - utama)
  :Buka link toko /order\n(dari bio IG atau scan QR toko);
  |Sistem|
  :Tampilkan produk, stok,\nsisa kuota per tanggal & zona antar;
  |Pembeli|
  :Pilih produk & jumlah;
  :Pilih tanggal kirim\n(>= hari ini + lead time pre-order terbesar);
  :Pilih zona antar atau ambil sendiri;
  :Isi nama, no. HP, alamat\n& metode bayar (QRIS / COD);
elseif () then (Chat WA bebas)
  :Kirim chat pesanan bebas ke WA penjual;
  |Penjual|
  :Tempel chat di dashboard\n(Tempel Chat);
  |Sistem|
  :Parser rule-based: cocokkan nama/alias produk,\njumlah, metode bayar & alamat;
  :Tampilkan pratinjau + bagian tidak dikenali;
  |Penjual|
  :Periksa & edit pratinjau\n(produk, jumlah, tanggal, zona, bayar, alamat);
else (Telegram - opsional, TELEGRAM_ENABLED=true)
  |Pembeli|
  :Kirim /pesan <no>x<jumlah> <qris|cod> ke bot;
endif
|Sistem|
:create_order: kunci baris produk (FOR UPDATE);
if (Stok cukup, tanggal sesuai lead time,\nkuota tanggal belum penuh & zona valid?) then (ya)
  :Kurangi stok;
  :Simpan pesanan (status: menunggu)\ntotal = subtotal + ongkir zona;
else (tidak)
  :Tolak pesanan & tampilkan alasannya\n(stok / kuota penuh / tanggal / zona);
  stop
endif
switch (Channel?)
case (Web)
  :Buka wa.me dengan teks pesanan terisi;
case (Chat WA)
  :Tampilkan nomor pesanan ke penjual;
case (Telegram)
  :Bot kirim ringkasan pesanan & tanggal kirim;
endswitch
if (Channel Web?) then (ya)
  |Pembeli|
  :Kirim pesan WA ke penjual;
else (tidak)
endif
|Pembeli|
if (Metode bayar?) then (QRIS)
  :Bayar via QRIS & kirim bukti lewat chat;
  |Penjual|
  :Cek pembayaran manual;
  if (Pembayaran valid?) then (ya)
    :Ubah status ke "dibayar";
  else (tidak)
    :Ubah status ke "batal";
    |Sistem|
    :Trigger: kembalikan stok\n(pesanan batal tidak bisa diaktifkan lagi);
    stop
  endif
else (COD)
endif
|Penjual|
:Lihat daftar produksi per tanggal kirim;
:Produksi & kirim pesanan;
:Ubah status: diproses -> dikirim -> selesai;
|Sistem|
:Simpan status\n(dashboard omzet & produksi ter-update);
|Pembeli|
:Terima pesanan\n(COD: bayar saat terima);
stop
@enduml
